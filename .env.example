# ------------------------------------------------------------------------------
# DASHCORD CONFIGURATION TEMPLATE (.env.example)
# ------------------------------------------------------------------------------

# 🤖 Core Discord Bot Settings
DISCORD_TOKEN=your_discord_bot_token_here
COMMAND_PREFIX=!
TIMEZONE=America/New_York

# 📁 Paths
ROUTES_PATH=routes.json
DYNAMIC_ROUTES_PATH=config/dynamic_routes.json

# ⚙️ Chat Commands & Helper Settings
DISPLAY_UNKNOWN_COMMAND_ERROR=true
DISPLAY_UNKNOWN_COMMAND_ERROR_SILENT_CHANNELS=123456789,987654321

# Visual reaction feedback for commands and file uploads
COMMAND_REACTION_ENABLED=true
COMMAND_REACTION_PENDING=⏳
COMMAND_REACTION_SUCCESS=✅
COMMAND_REACTION_FAIL=❌

# 🎛️ Panel Interaction & Behavior Settings
PANEL_SHOW_TITLE_DEFAULT=true
PANEL_REPOST_ON_STARTUP=true
PANEL_SPAWN_NEW_ON_CLICK=true
PANEL_STATUS_LINE=true
PANEL_ARCHIVE_DISABLE_BUTTONS=true
PANEL_FORCE_NEW_ON_STARTUP=true

# 🧹 Panel Cleanups & Scan Limits
PANEL_DELETE_OLD_PANELS=true
PANEL_SCAN_LIMIT=50

# 🏃 Sticky UI / Panel Persistence Loop
PANEL_PERSIST_DEFAULT=false
PANEL_PERSIST_INTERVAL_SECONDS=45
PANEL_PERSIST_CLEANUP_OLD_ACTIVE=true
PANEL_PERSIST_ON_RESPONSE=true
PANEL_PERSIST_ON_RESPONSE_DELAY=0

# 📡 Programmatic REST API Server Settings
API_ENABLED=false
API_PORT=8080
API_ALLOW_STATIC_OVERWRITE=false

# 🌐 Webhook Connectivity & Advanced Configuration
DASHCORD_SHARED_SECRET=your_super_secret_secret_here
HTTP_TIMEOUT_SECONDS=20
VERIFY_TLS=true

# 🐞 Troubleshooting & Logging Controls
DASHCORD_DEBUG=false
DEBUG_WEBHOOK=false

# Docker Console Output Buffer Control (Keep set to 1)
PYTHONUNBUFFERED=1