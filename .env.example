# ------------------------------------------------------------------------------
# DASHCORD CONFIGURATION TEMPLATE (.env.example)
# ------------------------------------------------------------------------------

# 🤖 Core Discord Bot Settings
DISCORD_TOKEN=your_discord_bot_token_here
COMMAND_PREFIX=!
TIMEZONE=America/New_York

# 📁 Configuration & Dynamic Storage Paths
ROUTES_PATH=routes.json
DYNAMIC_ROUTES_PATH=config/dynamic_routes.json

# ⚙️ Chat Commands & Helper Settings
# If true, bot replies with a customized list of authorized commands when a user typos
DISPLAY_UNKNOWN_COMMAND_ERROR=true
# Silent channels where "unknown command" help text will never be printed (e.g. log channels)
DISPLAY_UNKNOWN_COMMAND_ERROR_SILENT_CHANNELS=1441155156526895224

# Visual reaction feedback (reactions applied directly to user's typed chat messages)
COMMAND_REACTION_ENABLED=true
COMMAND_REACTION_PENDING=⏳
COMMAND_REACTION_SUCCESS=✅
COMMAND_REACTION_FAIL=❌

# 🎛️ Panel Baseline Behavior Settings (Panel-level configs override these)
PANEL_SHOW_TITLE_DEFAULT=false
PANEL_REPOST_ON_STARTUP=true
PANEL_SPAWN_NEW_ON_CLICK=false
PANEL_ARCHIVE_DISABLE_BUTTONS=true
PANEL_FORCE_NEW_ON_STARTUP=false

# 🎨 Panel Visual Status Indicators
PANEL_STATUS_LINE=true
PANEL_STATUS_EMOJI_PENDING=⏳
PANEL_STATUS_EMOJI_SUCCESS=✅
PANEL_STATUS_EMOJI_FAIL=❌
PANEL_STATUS_EMOJI_IN_EMBED=true
PANEL_STATUS_EMOJI_TITLE=true

# ⏱️ Panel Animations & Live Timers
# If true, the pending emoji will alternate back and forth during processing
PANEL_STATUS_ANIMATE_PENDING=true
PANEL_STATUS_EMOJI_PENDING_ALT=⌛
# Animation frame-rate (in seconds). 1.5s is the minimum safe limit to avoid Discord rate limits
PANEL_STATUS_ANIMATE_INTERVAL=1.5
# If true, appends the final execution time to the audit text line once completed
PANEL_STATUS_SHOW_ELAPSED=true
# If true, a live timer counts up in real-time while waiting for webhooks to reply
PANEL_STATUS_ANIMATE_ELAPSED=true

# 🧹 Panel Cleanups & Scan Limits
# Clean up orphaned panel messages on start up (mass-cleanup)
PANEL_DELETE_OLD_PANELS=false
# How many messages deep into chat history the bot will scan when cleaning up old panels
PANEL_SCAN_LIMIT=50

# 🏃 Sticky UI / Panel Persistence Loop
# If true, panels automatically jump to the bottom of the chat if they are buried by users talking
PANEL_PERSIST_DEFAULT=true
# Loop check interval (in seconds). Checks chat activity every X seconds to reposition panels
PANEL_PERSIST_INTERVAL_SECONDS=120
# Delete the old panel immediately after posting the new copy at the bottom of the chat
PANEL_PERSIST_CLEANUP_OLD_ACTIVE=false
# Instantly trigger the persistence reposition loop the moment a webhook completes
PANEL_PERSIST_ON_RESPONSE=true
# Delay (in seconds) before moving the panel to the bottom after webhook execution finishes
PANEL_PERSIST_ON_RESPONSE_DELAY=0

# 📡 Programmatic REST API Server Settings
API_ENABLED=true
API_PORT=8080
# If true, the dynamic API is permitted to overwrite static routes defined in routes.json
API_ALLOW_STATIC_OVERWRITE=false

# 🌐 Webhook Connectivity & Advanced Security
# Secret string passed as 'X-DashCord-Token' (or HTTP 'Authorization') to authenticate your n8n workflows
DASHCORD_SHARED_SECRET=X=lXy5s=0Vsz1-;K'aCa;)5D/[aiDh;2"64Yw5]zC8|PD@kW3khoPD,Lf2M9u!jl!13iU..KqrtF2:0rS]#.IMX*-B73g0KGQoO0V-=HGcZx\3Rs9iic=MS*"Q@.uzSsGMi6;,g4FS6*6mR'4zc
# How long the bot waits for n8n/Make to respond before raising a timeout. Set high for heavy automation
HTTP_TIMEOUT_SECONDS=320
# Set to false if hitting workflows hosted on local networks with self-signed SSL certificates
VERIFY_TLS=false

# 🐞 Troubleshooting & Logging Controls
DASHCORD_DEBUG=true
DEBUG_WEBHOOK=true

# Docker Console Output Buffer Control (Forces Python to flush outputs to stdout immediately)
PYTHONUNBUFFERED=1