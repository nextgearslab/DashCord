{
  "commands": {
    "ping": {
      "endpoint": "https://hook.us1.make.com/your-webhook-id",
      "method": "POST",
      "api_writable": true,
      "panel_persist_delay": 1.5,
      "allowed_users": [],
      "allowed_channels": []
    },
    "upload": {
      "endpoint": "https://n8n.yourdomain.com/webhook/file-upload",
      "method": "POST",
      "accept_attachments": true,
      "allow_without_command": true,
      "attachment_rules": {
        "extensions": [".json", ".csv"],
        "max_bytes": 2500000,
        "require_json": false
      },
      "attachment_reply": {
        "mode": "errors",
        "success_template": "📦 Successfully sent {ok} out of {total} files.",
        "error_template": "❌ Upload errors ({bad}/{total}):\n{errors}"
      }
    },
    "weather": {
      "endpoint": "https://your-api.com/weather",
      "method": "GET",
      "api_protected": true,
      "allowed_channels": [112233445566778899]
    },
    "advanced-ai": {
      "endpoint": "http://192.168.1.100:8000/api/run-task",
      "method": "POST",
      "allowed_users": [987654321098765432],
      "accept_attachments": true,
      "allow_without_command": true,
      "headers": {
        "Authorization": "Bearer YOUR_CUSTOM_TOKEN_HERE",
        "X-Custom-Flag": "true"
      },
      "body_template": {
        "user_data": {
          "id": "{{discord.user_id}}",
          "name": "{{discord.user_display}}",
          "channel": "{{discord.channel_name}}"
        },
        "task_data": {
          "user_input": "{{raw}}",
          "args_list": "{{args}}",
          "request_id": "{{nonce}}",
          "file_base64": "{{attachment_b64}}"
        },
        "trigger_source": "discord",
        "dry_run": false
      }
    },
    "googlehealth": {
      "endpoint": "https://n8n.yourdomain.com/webhook/googlehealth",
      "method": "POST",
      "allowed_users": [],
      "allowed_channels": []
    }
  },
  "panels": {
    "Server_Controls": {
      "channels": ["123456789012345678", "876543210987654321"],
      "api_writable": true,
      "persist": {
        "enabled": true,
        "interval_seconds": 120,
        "cleanup_old_active": true
      },
      "embed": {
        "title": "🖥️ Production Server Controls",
        "description": "Critical infrastructure management. Authorized users only.",
        "color": "#e74c3c"
      },
      "buttons": [
        {
          "label": "Restart Server",
          "command": "ping",
          "args": ["restart"],
          "style": "danger",
          "emoji": "⚠️"
        },
        {
          "label": "Check Status",
          "command": "ping",
          "args": ["status"],
          "style": "primary",
          "emoji": "📡"
        },
        {
          "label": "Deploy Update",
          "command": "ping",
          "args": ["deploy"],
          "style": "success",
          "emoji": "🚀",
          "modal": {
            "title": "Deploy New Container",
            "inputs": [
              { "id": "image_tag", "label": "Docker Tag / Version", "placeholder": "e.g. latest, v2.1.0", "required": true },
              { "id": "deploy_notes", "label": "Release Notes", "placeholder": "What changed in this deployment?", "required": false, "long": true }
            ]
          }
        }
      ]
    },
    "Home_Automation": {
      "channels": ["112233445566778899"],
      "content": "👋 **Welcome to your Smart Home Hub!** Use the menus below to control your environment.",
      "show_title": false,
      "api_protected": true,
      "embed": {
        "title": "🏠 Smart Home Hub",
        "color": "#3498db"
      },
      "selects": [
        {
          "placeholder": "🌤️ Weather & Environment...",
          "options": [
            { "label": "Get Local Weather", "command": "weather", "args": ["now"], "emoji": "🌤️" },
            { "label": "Check Indoor Temp", "command": "weather", "args": ["indoor"], "emoji": "🌡️" }
          ]
        }
      ],
      "buttons": [
        {
          "label": "Run AI Task",
          "command": "advanced-ai",
          "args": ["force"],
          "style": "success",
          "emoji": "🧠"
        },
        { 
          "label": "Log Weight", 
          "command": "googlehealth", 
          "args": ["log_weight"], 
          "style": "primary", 
          "emoji": "⚖️",
          "modal": {
            "title": "Log Daily Weight",
            "inputs": [
              { 
                "id": "weight_lbs", 
                "label": "Weight (lbs)", 
                "placeholder": "e.g. 185.2", 
                "required": true 
              },
              { 
                "id": "notes", 
                "label": "Notes (Optional)", 
                "placeholder": "How are you feeling?", 
                "required": false,
                "long": true 
              }
            ]
          }
        }
      ]
    }
  }
}